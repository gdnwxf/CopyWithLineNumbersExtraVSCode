{
  "name": "copy-extra-by-qinghao-plus",
  "displayName": "Copy Extra By QingHao Plus",
  "description": "Copy selected code in VS Code with file paths, line ranges, and line numbers.",
  "version": "0.0.17",
  "publisher": "gdnwxf",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdnwxf/CopyWithLineNumbersExtraVSCode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:copyExtra.copyFullPathAndLineRangeOnly",
    "onCommand:copyExtra.copyRelativePathAndLineRangeOnly",
    "onCommand:copyExtra.copyFullPathLineRangeScopeSelected",
    "onCommand:copyExtra.copyFullPathLineRangeSelected",
    "onCommand:copyExtra.copyFullPathLineNumbersSelected",
    "onCommand:copyExtra.copyRelativePathLineRangeSelected",
    "onCommand:copyExtra.copyRelativePathLineNumbersSelected",
    "onCommand:copyExtra.copyFullPathLineRange",
    "onCommand:copyExtra.copyFullPathLineNumbers",
    "onCommand:copyExtra.copyRelativePathLineRange",
    "onCommand:copyExtra.copyRelativePathLineNumbers",
    "onCommand:copyExtra.copyExplorerRelativePath",
    "onCommand:copyExtra.copyExplorerFullPath",
    "onCommand:copyExtra.copyScmFolderFullPath",
    "onCommand:copyExtra.copyScmFolderRelativePath"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "copyExtra.editorContext",
        "label": "Copy Extra"
      },
      {
        "id": "copyExtra.explorerContext",
        "label": "Copy Extra"
      },
      {
        "id": "copyExtra.scmFolderContext",
        "label": "Copy Extra"
      }
    ],
    "commands": [
      {
        "command": "copyExtra.copyFullPathAndLineRangeOnly",
        "title": "Copy Full Path and Line Range Only",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyRelativePathAndLineRangeOnly",
        "title": "Copy Relative Path Line Range Only",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyFullPathLineRangeScopeSelected",
        "title": "Copy Full Path Line Range Scope Selected",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyFullPathLineRangeSelected",
        "title": "Copy Full Path Line Range Selected",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyFullPathLineNumbersSelected",
        "title": "Copy Full Path Line Numbers Selected",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyRelativePathLineRangeSelected",
        "title": "Copy Relative Path Line Range Selected",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyRelativePathLineNumbersSelected",
        "title": "Copy Relative Path Line Numbers Selected",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyFullPathLineRange",
        "title": "Copy Full Path Line Range",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyFullPathLineNumbers",
        "title": "Copy Full Path Line Numbers",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyRelativePathLineRange",
        "title": "Copy Relative Path Line Range",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyRelativePathLineNumbers",
        "title": "Copy Relative Path Line Numbers",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyExplorerRelativePath",
        "title": "Copy Relative Path",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyExplorerFullPath",
        "title": "Copy Full Path",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyScmFolderFullPath",
        "title": "Copy Full Path",
        "category": "Copy Extra"
      },
      {
        "command": "copyExtra.copyScmFolderRelativePath",
        "title": "Copy Relative Path",
        "category": "Copy Extra"
      }
    ],
    "configuration": {
      "title": "Copy Extra",
      "properties": {
        "copyExtra.windowsCopyPathFormat": {
          "order": 1,
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "wsl",
            "unix",
            "cygwin",
            "msys",
            "gitBash"
          ],
          "enumItemLabels": [
            "Default (D:\\llama.cpp)",
            "WSL (/mnt/d/llama.cpp)",
            "Unix (D:/llama.cpp)",
            "Cygwin (/cygdrive/d/llama.cpp)",
            "MSYS / MSYS2 (/d/llama.cpp)",
            "Git Bash (/d/llama.cpp)"
          ],
          "description": "Controls copied full paths and relative path separators on Windows. macOS, Linux, and Unix use the default VS Code path format."
        },
        "copyExtra.pathPrefix": {
          "order": 2,
          "type": "string",
          "default": "Path:",
          "description": "Prefix added before copied folder paths in Explorer. Leave empty to output no Path: prefix."
        },
        "copyExtra.filePrefix": {
          "order": 3,
          "type": "string",
          "default": "File:",
          "description": "Prefix added before copied file paths. Leave empty to output no File: prefix."
        },
        "copyExtra.fileSuffix": {
          "order": 4,
          "type": "string",
          "default": "行",
          "description": "Suffix added after copied editor line ranges. Leave empty to output no line suffix."
        },
        "copyExtra.scopeSelectedBeforeLineCount": {
          "order": 5,
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Number of lines before the selection included in the line range header for Copy Full Path Line Range Scope Selected."
        },
        "copyExtra.scopeSelectedAfterLineCount": {
          "order": 6,
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Number of lines after the selection included in the line range header for Copy Full Path Line Range Scope Selected."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "submenu": "copyExtra.editorContext",
          "group": "navigation@1",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "submenu": "copyExtra.explorerContext",
          "group": "navigation@1",
          "when": "resourceScheme == file || explorerResourceIsFile || explorerResourceIsFolder"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "copyExtra.explorerContext",
          "group": "6_copypath@1",
          "when": "resourceScheme == file || resourceScheme == git"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "copyExtra.explorerContext",
          "group": "navigation@1"
        }
      ],
      "scm/resourceFolder/context": [
        {
          "submenu": "copyExtra.scmFolderContext",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "submenu": "copyExtra.explorerContext",
          "group": "navigation@1",
          "when": "resourceScheme == file"
        }
      ],
      "copyExtra.editorContext": [
        {
          "command": "copyExtra.copyFullPathAndLineRangeOnly",
          "group": "1_rangeOnly@1",
          "when": "editorTextFocus"
        },
        {
          "command": "copyExtra.copyRelativePathAndLineRangeOnly",
          "group": "1_rangeOnly@2",
          "when": "editorTextFocus"
        },
        {
          "command": "copyExtra.copyFullPathLineRangeScopeSelected",
          "group": "2_scope@1",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "copyExtra.copyFullPathLineRangeSelected",
          "group": "3_selected@1",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "copyExtra.copyFullPathLineNumbersSelected",
          "group": "3_selected@2",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "copyExtra.copyRelativePathLineRangeSelected",
          "group": "3_selected@3",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "copyExtra.copyRelativePathLineNumbersSelected",
          "group": "3_selected@4",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "copyExtra.copyFullPathLineRange",
          "group": "4_fullLines@1",
          "when": "editorTextFocus"
        },
        {
          "command": "copyExtra.copyFullPathLineNumbers",
          "group": "4_fullLines@2",
          "when": "editorTextFocus"
        },
        {
          "command": "copyExtra.copyRelativePathLineRange",
          "group": "4_fullLines@3",
          "when": "editorTextFocus"
        },
        {
          "command": "copyExtra.copyRelativePathLineNumbers",
          "group": "4_fullLines@4",
          "when": "editorTextFocus"
        }
      ],
      "copyExtra.explorerContext": [
        {
          "command": "copyExtra.copyExplorerFullPath",
          "group": "1_path@1"
        },
        {
          "command": "copyExtra.copyExplorerRelativePath",
          "group": "1_path@2"
        }
      ],
      "copyExtra.scmFolderContext": [
        {
          "command": "copyExtra.copyScmFolderFullPath",
          "group": "1_path@1"
        },
        {
          "command": "copyExtra.copyScmFolderRelativePath",
          "group": "1_path@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copyExtra.copyExplorerFullPath",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "explorerResourceIsFile || explorerResourceIsFolder"
      },
      {
        "command": "copyExtra.copyFullPathLineRangeScopeSelected",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run build && node --test dist/copyFormatter.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.3",
    "@vscode/vsce": "^3.6.2"
  }
}
